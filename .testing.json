{
  "mutate": {
    "include": ["design/src/js/data/**/*.js", "design/*.py"],
    "select_command": "python scripts/mutate_tests.py {path}",
    "test_command": {"py": "python -m pytest -x -q -p no:randomly -m \"not render\" {tests}"},
    "floor": 75,
    "target": 90
  },
  "limits": {
    "ms": {"unit": 50, "component": 200, "integration": 1000, "e2e": 15000},
    "layers": {"python": "unit", "node": "unit", "component": "component", "build": "integration", "browser": "e2e", "integration": "integration"},
    "suites": {
      "fast": {"layers": ["unit", "integration"], "wall_s": 10},
      "component": {"layers": ["component"], "wall_s": 35}
    },
    "factor": 2.0
  },
  "freeze": {
    "files": [
      "tests/golden/board.json",
      "tests/golden/build.json",
      "tests/golden/chat.json",
      "tests/golden/dfs.json",
      "tests/golden/digest.json",
      "tests/golden/finder.json",
      "tests/golden/lboard.json",
      "tests/golden/league.json",
      "tests/golden/live.json",
      "tests/golden/matchups.json",
      "tests/golden/myrecap.json",
      "tests/golden/news.json",
      "tests/golden/parlay.json",
      "tests/golden/preview.json",
      "tests/golden/profile.json",
      "tests/golden/ranks.json",
      "tests/golden/recap.json",
      "tests/golden/records.json",
      "tests/golden/role.json",
      "tests/golden/roster.json",
      "tests/golden/schedule.json",
      "tests/golden/search.json",
      "tests/golden/strip.json",
      "tests/golden/trades.json",
      "tests/golden/usage.json",
      "tests/golden/waivers.json",
      "tests/golden/weather.json",
      "tests/golden/weekrecap.json"
    ],
    "shrink": [
      "tests/test_budgets.py::JS_BACKLOG",
      "tests/test_budgets.py::PY_BACKLOG",
      "tests/test_budgets.py::PY_FILE_BACKLOG",
      "tests/test_layer_ratchet.py::BACKLOG",
      "tests/test_layer_ratchet.py::FULL_LOADS"
    ]
  },
  "flake": {
    "runs": 5,
    "args": ["-n", "auto", "--dist", "loadgroup"],
    "timeout_s": 900
  }
}
