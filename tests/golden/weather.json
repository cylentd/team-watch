"view": "<div class=\"wrap wt\" data-testid=\"weather-view\">\n    <h2 class=\"wt-title\">Week 2 weather</h2>\n    <section class=\"wt-sec\"><div class=\"rule\" data-testid=\"weather-rule\"><h2>Games where weather lowers scoring</h2><span class=\"wt-n\">1 game</span><span class=\"hair\"></span></div>\n        <div class=\"wt-grid\"><article class=\"wt-card\" data-testid=\"weather-card\">\n    <div class=\"wt-top\"><b class=\"wt-match\" data-testid=\"weather-card-match\">DET @ SEA</b><span class=\"wt-kick\">Mon 10:05 AM</span></div>\n    <p class=\"wt-cond\" data-testid=\"weather-cond\"><span class=\"wt-c on\"><svg class=\"pf-wx-i wt-sky wind\" data-testid=\"weather-sky\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" style=\"--wx-s:0.57s\"><path class=\"wt-gust\" style=\"--i:0\" d=\"M3 8h11a3 3 0 1 0-3-3\"></path><path class=\"wt-gust\" style=\"--i:1\" d=\"M3 12h15a3 3 0 1 1-3 3\"></path><path class=\"wt-gust\" style=\"--i:2\" d=\"M3 16h8a2 2 0 1 1-2 2\"></path></svg>15 to 22 mph wind</span><span class=\"wt-dot\"> \u00b7 </span><span class=\"wt-c on\"><svg class=\"pf-wx-i wt-sky rain\" data-testid=\"weather-sky\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M7 15a4 4 0 0 1-.6-7.95A6 6 0 0 1 18 6.5 3.5 3.5 0 0 1 17.5 15Z\"></path><path class=\"wt-drop\" style=\"--i:0\" d=\"M8 18l-1 3\"></path><path class=\"wt-drop\" style=\"--i:1\" d=\"M12 18l-1 3\"></path><path class=\"wt-drop\" style=\"--i:2\" d=\"M16 18l-1 3\"></path></svg>70% chance of rain</span><span class=\"wt-dot\"> \u00b7 </span><span class=\"wt-c\">61\u00b0F</span></p><p class=\"wt-fx\" data-testid=\"weather-fx\"><span class=\"wt-e\">QBs about <b>1.5</b> fewer points</span><span class=\"wt-dot\">&nbsp;\u00b7 </span><span class=\"wt-e\">WRs about <b>1</b> fewer</span><span class=\"wt-dot\">&nbsp;\u00b7 </span><span class=\"wt-e\">TEs about <b>0.5</b> fewer</span><span class=\"wt-dot\">&nbsp;\u00b7 </span><span class=\"wt-e\">kickers about <b>1.5</b> fewer</span></p>\n    <div class=\"wt-hits\"><h3 data-testid=\"weather-hits-head\">Who it hits<span>already in his projection</span></h3><ul><li data-testid=\"weather-hit\"><button type=\"button\" class=\"wt-p\" data-wt=\"0:0\">\n      <span class=\"wt-pos\" data-testid=\"weather-hit-part\">WR</span><span class=\"wt-nm\" data-testid=\"weather-hit-part\">A. St. Brown</span>\n      <span class=\"wt-tm\" data-testid=\"weather-hit-part\">DET</span></button><span class=\"wt-adj\" data-testid=\"weather-adj\" title=\"\u22121.1 pts already in his projection for this weather\">\u22121.1</span></li></ul></div>\n  </article></div></section>\n    <div class=\"wt-rest\"><section class=\"wt-sec\"><div class=\"rule\" data-testid=\"weather-rule\"><h2>Outdoors</h2><span class=\"wt-n\">2 games</span><span class=\"hair\"></span></div><ul class=\"wt-rows\"><li class=\"wt-row\" data-testid=\"weather-row\"><b class=\"wt-match\">MIA @ NE</b>\n    <span class=\"wt-kick\">Mon 10:05 AM</span><span class=\"wt-rs\">No forecast yet</span></li><li class=\"wt-row\" data-testid=\"weather-row\"><b class=\"wt-match\">JAX @ IND</b>\n    <span class=\"wt-kick\">Mon 1:05 PM</span><span class=\"wt-rs\">74\u00b0F \u00b7 7 mph</span></li></ul></section><section class=\"wt-sec\"><div class=\"rule\" data-testid=\"weather-rule\"><h2>Indoors</h2><span class=\"wt-n\">1 game</span><span class=\"hair\"></span></div><ul class=\"wt-rows\"><li class=\"wt-row\" data-testid=\"weather-row\"><b class=\"wt-match\">WSH @ LAR</b>\n    <span class=\"wt-kick\">Mon 1:25 PM</span><span class=\"wt-rs\">Dome, no weather</span></li></ul></section></div>\n  </div>"
}
